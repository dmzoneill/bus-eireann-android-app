<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/connectionsLayout" android:layout_width="fill_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:text="Date" style="@style/BusLayoutTextView4"/>
        <TextView android:text="" android:id="@+id/connectionDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8pt" android:textStyle="bold" android:textColor="#FF222222"/>
    </LinearLayout>
    <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:text="Departure" style="@style/BusLayoutTextView4"/>
        <TextView android:text="" android:id="@+id/connectionDeparture" style="@style/BusLayoutTextView5"/>
        <TextView android:text="Duration" style="@style/BusLayoutTextView6"/>
        <TextView android:text="" android:id="@+id/connectionDuration" style="@style/BusLayoutTextView7"/>
    </LinearLayout>
    <LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:text="Arrival" style="@style/BusLayoutTextView4"/>
        <TextView android:text="" android:id="@+id/connectionArrival" style="@style/BusLayoutTextView5"/>
        <TextView android:text="Changes" style="@style/BusLayoutTextView6"/>
        <TextView android:text="" android:id="@+id/connectionChanges" style="@style/BusLayoutTextView7"/>
    </LinearLayout>
</LinearLayout>
